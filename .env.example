# Địa chỉ bind trên host (mặc định 127.0.0.1 để không vượt qua firewall UFW, đưa ra ngoài qua Nginx HTTPS)
BIND_HOST=127.0.0.1

# Cổng lắng nghe trên host
PORT=7554

# Mật khẩu bảo vệ UI & API (BẮT BUỘC đặt mạnh khi chạy trên VPS! Tạo bằng: openssl rand -hex 32)
DARKIN_TOKEN=

# Đặt true nếu chạy sau Nginx / Cloudflare Reverse Proxy để nhận diện đúng IP client & HTTPS
DARKIN_TRUST_PROXY=false

# Đường dẫn thư mục chứa các dự án trên máy host sẽ được mount vào /workspace trong container
# VD Linux/VPS: /var/www
# VD Windows: D:/work
DARKIN_PROJECTS_DIR=./projects

# Múi giờ cho timestamp logs
TZ=Asia/Ho_Chi_Minh
